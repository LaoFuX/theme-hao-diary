---
import { shell } from "../layouts/Shell";
import {sidebar} from "../components/Sidebar";
import {posts} from "../components/Posts";
const html = shell("<div class=\"wrap listing-title\"><h1 th:text=\"${author.displayName}\"></h1></div>"+'<div class="wrap layout">'+sidebar+posts+'</div>', "${author.displayName + ' · ' + site.title}");
---
<Fragment set:html={html} />
