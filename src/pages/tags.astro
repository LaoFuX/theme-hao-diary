---
import { shell } from "../layouts/Shell";

const html = shell("<section class=\"wrap listing-title\"><h1>文章标签</h1><div class=\"taxonomy\"><a th:each=\"item : ${tagFinder.listAll()}\" th:href=\"${item.status.permalink}\" th:text=\"${item.spec.displayName}\"></a></div></section>", "${'文章标签 · ' + site.title}");
---
<Fragment set:html={html} />
